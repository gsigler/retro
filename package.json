{
  "name": "retro",
  "version": "0.0.1",
  "private": true,
  "description": "Retro - a retrospective platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run start:dev -w @retro/api",
    "dev:web": "npm run dev -w @retro/web",
    "build:api": "npm run build -w @retro/api",
    "build:web": "npm run build -w @retro/web",
    "test:api": "npm test -w @retro/api",
    "test:web": "npm test -w @retro/web",
    "test:e2e": "npx playwright test",
    "lint": "eslint apps/api && eslint apps/web",
    "lint:fix": "eslint apps/api --fix && eslint apps/web --fix",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx}\" \"apps/**/test/**/*.ts\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "format:check": "prettier --check \"apps/**/src/**/*.{ts,tsx}\" \"apps/**/test/**/*.ts\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "db:generate": "npm run prisma:generate -w @retro/api",
    "db:migrate:dev": "npm run prisma:migrate:dev -w @retro/api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy -w @retro/api",
    "db:studio": "npm run prisma:studio -w @retro/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/**/src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "apps/**/test/**/*.ts": [
      "prettier --write"
    ]
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "@angular-devkit/core": {
      "ajv": "^8.18.0"
    },
    "ajv-formats": {
      "ajv": "^8.18.0"
    },
    "hono": "^4.12.4",
    "@hono/node-server": "^1.19.10",
    "lodash": "^4.17.23"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "detect-port": "^2.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
