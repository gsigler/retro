# Database (Railway provides this automatically for managed PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retro?schema=public

# API
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=
JWT_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Web (baked into the Vite build)
VITE_API_URL=http://localhost:3000
APP_URL=http://localhost:5173
