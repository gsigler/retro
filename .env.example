# Database (Railway provides this automatically for managed PostgreSQL)
# One shared Postgres instance on port 5432 for all workspaces.
# API/web ports are auto-assigned to available ports by scripts/dev.mjs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retro?schema=public

# API
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=
JWT_EXPIRATION=24h

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Web (baked into the Vite build)
VITE_API_URL=http://localhost:3000/api
APP_URL=http://localhost:5173
