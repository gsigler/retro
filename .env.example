# Database (Railway provides this automatically for managed PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retro?schema=public

# API
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=
JWT_EXPIRATION=7d
MAGIC_LINK_EXPIRATION_MINUTES=15

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=

# Web (baked into the Vite build)
VITE_API_URL=http://localhost:3000
APP_URL=http://localhost:5173
